@model IEnumerable<CBTSWE2_TP03.Models.Produto>
@{
    ViewData["Title"] = "Lista de Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold">Lista de Produtos</h2>
    <a asp-action="Create" class="btn btn-success shadow-sm">+ Novo Produto</a>
</div>

<div class="table-responsive shadow-sm rounded bg-white p-3">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nome)</th>
                <th>@Html.DisplayNameFor(model => model.Preco)</th>
                <th>Estoque</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.Nome)</td>

                    <td class="text-success fw-bold">@Html.DisplayFor(modelItem => item.Preco)</td>

                    <td>
                        <span class="badge @(item.QuantidadeEstoque > 0 ? "bg-primary" : "bg-danger")">
                            @Html.DisplayFor(modelItem => item.QuantidadeEstoque) un.
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Excluir</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-center text-muted mt-3">Nenhum produto cadastrado no momento.</p>
    }
</div>
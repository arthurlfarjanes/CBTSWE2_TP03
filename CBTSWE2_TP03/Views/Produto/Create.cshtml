@model CBTSWE2_TP03.Models.Produto
@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white"><h5 class="mb-0">Cadastrar Novo Produto</h5></div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Digite o nome do produto" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label fw-bold"></label>
                        <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Detalhes do produto..."></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Preco" class="form-label fw-bold"></label>
                            <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Preco" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="QuantidadeEstoque" class="form-label fw-bold">Estoque</label>
                            <input asp-for="QuantidadeEstoque" class="form-control" type="number" />
                            <span asp-validation-for="QuantidadeEstoque" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar e Voltar</a>
                        <button type="submit" class="btn btn-success px-4">Salvar Produto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
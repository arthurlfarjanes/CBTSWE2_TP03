@{
    ViewData["Title"] = "Página Inicial";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-primary fw-bold mb-3">Sistema de Gestão de Produtos</h1>
    <p class="lead text-muted">Aplicação desenvolvida com ASP.NET MVC e Entity Framework.</p>

    <hr class="w-50 mx-auto my-5" />

    <div class="row justify-content-center">
        <!-- Cartão de Acesso ao Sistema -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 d-flex flex-column text-center">
                    <h4 class="card-title fw-bold text-dark mb-3">Painel de Controle</h4>
                    <p class="card-text text-muted mb-4">
                        Acesse a área de gerenciamento para adicionar, editar, excluir e visualizar o seu catálogo e estoque.
                    </p>
                    <a asp-controller="Produto" asp-action="Index" class="btn btn-primary btn-lg mt-auto shadow-sm">
                        Acessar Lista de Produtos
                    </a>
                </div>
            </div>
        </div>

        <!-- Cartão de Créditos -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h5 class="mb-0">Autores do Projeto</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush text-start">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="fw-bold text-secondary">ADRIANO JÚNIOR DE SOUZA ALMEIDA</span>
                            <span class="badge bg-secondary rounded-pill fs-6">CB3030644</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="fw-bold text-secondary">ARTHUR LANZILOTTI FARJANES</span>
                            <span class="badge bg-secondary rounded-pill fs-6">CB3031306</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>